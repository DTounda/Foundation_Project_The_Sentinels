NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change_me
DB_NAME=medicheck

# Use a long random string (at least 32 characters). Never commit the real .env file.
JWT_SECRET=change_me_to_a_long_random_string_of_32_chars_or_more
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# Comma-separated list of allowed origins, or * for development
CORS_ORIGIN=*

# Database: mysql (default) or mongo
DB_DRIVER=mysql
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/
MONGODB_DB=medicheck

# Free key from https://ocr.space/ocrapi/freekey
OCR_API_KEY=